{
  "manifest_version": 3,
  "name": "SDR HDR",
  "version": "1.3.0",
  "description": "DRM 없는 SDR 영상을 EDR로 확장 표시",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/ns.js",
        "content/detect.js",
        "content/params.js",
        "content/itm.wgsl.js",
        "content/hud.js",
        "content/renderer.js",
        "content/overlay.js",
        "content/main.js"
      ]
    }
  ],
  "permissions": ["storage", "nativeMessaging"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SDR HDR",
    "default_icon": {
      "16": "popup/icons/icon-16.png",
      "19": "popup/icons/icon-19.png",
      "32": "popup/icons/icon-32.png",
      "38": "popup/icons/icon-38.png"
    }
  },
  "background": {
    "service_worker": "content/background.js"
  },
  "icons": {
    "48": "popup/icons/icon-48.png",
    "96": "popup/icons/icon-96.png",
    "128": "popup/icons/icon-128.png",
    "256": "popup/icons/icon-256.png",
    "512": "popup/icons/icon-512.png"
  }
}
