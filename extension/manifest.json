{
  "manifest_version": 3,
  "name": "SDR HDR",
  "version": "1.0.1",
  "description": "DRM 없는 SDR 영상을 EDR로 확장 표시",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/ns.js",
        "content/detect.js",
        "content/params.js",
        "content/itm.wgsl.js",
        "content/hud.js",
        "content/renderer.js",
        "content/overlay.js",
        "content/main.js"
      ]
    }
  ],
  "permissions": ["storage"],
  "action": { "default_popup": "popup/popup.html" }
}
